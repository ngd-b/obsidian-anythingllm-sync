{
  "name": "obsidian-anythingllm-sync",
  "version": "1.1.0",
  "description": "Sync Markdown notes from selected Obsidian folders to an AnythingLLM workspace.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "esbuild": "^0.25.5",
    "obsidian": "latest",
    "typescript": "^5.8.3"
  },
  "author": "HBoot",
  "license": "MIT",
  "keywords": [
    "obsidian",
    "anythingllm",
    "knowledge-base",
    "rag",
    "markdown",
    "sync"
  ]
}
